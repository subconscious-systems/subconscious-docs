{
  "openapi": "3.1.0",
  "info": {
    "title": "Subconscious platform API",
    "version": "1.0.0",
    "description": "Management keys and organization usage on the Subconscious platform. Inference stays on https://api.subconscious.dev/v1."
  },
  "servers": [
    {
      "url": "https://platform.subconscious.dev"
    }
  ],
  "paths": {
    "/api/v1/management/api-keys": {
      "post": {
        "operationId": "createInferenceKey",
        "summary": "Create an inference key",
        "description": "Mints an inference key for the organization that owns the management key. The `key` secret is returned once. Later usage and delete calls use `keyPrefix`. A management key cannot run inference. Inference keys presented here are rejected.",
        "security": [
          { "bearerAuth": [] },
          { "apiKeyAuth": [] }
        ],
        "x-codeSamples": [
          {
            "lang": "bash",
            "label": "cURL",
            "source": "curl https://platform.subconscious.dev/api/v1/management/api-keys \\\n  -H \"Authorization: Bearer sk-mgmt-...\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"name\": \"tenant-42\"}'"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255,
                    "description": "Display name for the inference key. Must be non-empty after trimming and at most 255 characters.",
                    "example": "tenant-42"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Inference key created. `key` is shown only in this response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["apiKey"],
                  "properties": {
                    "apiKey": {
                      "type": "object",
                      "required": ["id", "name", "key", "keyPrefix", "createdAt"],
                      "properties": {
                        "id": { "type": "string", "description": "Platform id of the key." },
                        "name": { "type": "string" },
                        "key": {
                          "type": "string",
                          "description": "Inference secret (`sk-gw-...`). Store it now. It is not returned again."
                        },
                        "keyPrefix": {
                          "type": "string",
                          "description": "Prefix used by the delete and per-key usage endpoints."
                        },
                        "createdAt": { "type": "string", "format": "date-time" }
                      }
                    }
                  }
                },
                "example": {
                  "apiKey": {
                    "id": "5f0c8a1e-2b4d-4c7e-9a10-6d3f2e1b0c9a",
                    "name": "tenant-42",
                    "key": "sk-gw-...",
                    "keyPrefix": "a1b2c3d4",
                    "createdAt": "2026-09-30T21:40:00.000Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "The body is not JSON, `name` is missing or longer than 255 characters, or the organization is at its inference-key limit.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "examples": {
                  "name": {
                    "value": { "error": "Body must include a non-empty \"name\" (max 255 chars)" }
                  },
                  "limit": {
                    "value": { "error": "Maximum number of keys is 10" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or inactive management key.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "403": {
            "description": "The key is not a management key, or the organization does not have closed-beta access.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "examples": {
                  "notManagement": {
                    "value": { "error": "Key is not a management API key" }
                  },
                  "closedBeta": {
                    "value": { "error": "Closed-beta access is required" }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The key could not be created.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      },
      "get": {
        "operationId": "listInferenceKeys",
        "summary": "List inference keys",
        "description": "Lists inference keys for the organization that owns the management key, newest first. Includes inactive keys. Hidden keys and management keys are omitted. Secrets are not included.",
        "security": [
          { "bearerAuth": [] },
          { "apiKeyAuth": [] }
        ],
        "x-codeSamples": [
          {
            "lang": "bash",
            "label": "cURL",
            "source": "curl https://platform.subconscious.dev/api/v1/management/api-keys \\\n  -H \"Authorization: Bearer sk-mgmt-...\""
          }
        ],
        "responses": {
          "200": {
            "description": "Inference keys for the organization.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["apiKeys"],
                  "properties": {
                    "apiKeys": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["id", "name", "keyPrefix", "isActive", "createdAt", "lastUsedAt"],
                        "properties": {
                          "id": { "type": "string" },
                          "name": { "type": "string" },
                          "keyPrefix": { "type": "string" },
                          "isActive": {
                            "type": "boolean",
                            "description": "False after the key has been deleted."
                          },
                          "createdAt": { "type": "string", "format": "date-time" },
                          "lastUsedAt": {
                            "type": ["string", "null"],
                            "format": "date-time"
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "apiKeys": [
                    {
                      "id": "5f0c8a1e-2b4d-4c7e-9a10-6d3f2e1b0c9a",
                      "name": "tenant-42",
                      "keyPrefix": "a1b2c3d4",
                      "isActive": true,
                      "createdAt": "2026-09-30T21:40:00.000Z",
                      "lastUsedAt": "2026-09-30T22:05:00.000Z"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or inactive management key.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "403": {
            "description": "The key is not a management key.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/api/v1/management/api-keys/{keyPrefix}": {
      "delete": {
        "operationId": "deleteInferenceKey",
        "summary": "Delete an inference key",
        "description": "Revokes the inference key at the gateway and deactivates it. Requests that still present the deleted key fail. The lookup is limited to active inference keys in the management key's organization. Management keys cannot be deleted here.",
        "security": [
          { "bearerAuth": [] },
          { "apiKeyAuth": [] }
        ],
        "x-codeSamples": [
          {
            "lang": "bash",
            "label": "cURL",
            "source": "curl -X DELETE https://platform.subconscious.dev/api/v1/management/api-keys/a1b2c3d4 \\\n  -H \"Authorization: Bearer sk-mgmt-...\""
          }
        ],
        "parameters": [
          { "$ref": "#/components/parameters/keyPrefix" }
        ],
        "responses": {
          "200": {
            "description": "The key was revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["revoked", "id", "keyPrefix"],
                  "properties": {
                    "revoked": { "type": "boolean", "enum": [true] },
                    "id": { "type": "string" },
                    "keyPrefix": { "type": "string" }
                  }
                },
                "example": {
                  "revoked": true,
                  "id": "5f0c8a1e-2b4d-4c7e-9a10-6d3f2e1b0c9a",
                  "keyPrefix": "a1b2c3d4"
                }
              }
            }
          },
          "401": {
            "description": "Missing or inactive management key.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "403": {
            "description": "The key is not a management key.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "404": {
            "description": "No active inference key in this organization matches the prefix.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "No active API key with prefix a1b2c3d4" }
              }
            }
          },
          "502": {
            "description": "The gateway did not revoke the key. The platform key stays active. Retry the request.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "500": {
            "description": "The key could not be deleted.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/api/v1/management/api-keys/{keyPrefix}/usage": {
      "get": {
        "operationId": "getInferenceKeyUsage",
        "summary": "Get key usage",
        "description": "Daily token and request counts for one inference key, from the durable UTC-day rollup. Dollar amounts are omitted because rates depend on the purchase. Each response is a snapshot of the requested window. Take deltas between fetches, or read a closed UTC day once, to build a ledger. `from` and `to` default to the last 30 days, inclusive of today. The span cannot exceed 90 days. A value that is not `YYYY-MM-DD` is ignored and the default is used.",
        "security": [
          { "bearerAuth": [] },
          { "apiKeyAuth": [] }
        ],
        "x-codeSamples": [
          {
            "lang": "bash",
            "label": "cURL",
            "source": "curl \"https://platform.subconscious.dev/api/v1/management/api-keys/a1b2c3d4/usage?from=2026-09-01&to=2026-09-30\" \\\n  -H \"Authorization: Bearer sk-mgmt-...\""
          }
        ],
        "parameters": [
          { "$ref": "#/components/parameters/keyPrefix" },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date", "example": "2026-09-01" },
            "description": "First UTC day in the window (`YYYY-MM-DD`). Defaults to 30 days before today, inclusive."
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date", "example": "2026-09-30" },
            "description": "Last UTC day in the window (`YYYY-MM-DD`). Defaults to today."
          }
        ],
        "responses": {
          "200": {
            "description": "Token and request counts for the key over the window.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["apiKeyId", "from", "to", "totals", "daily", "byModel"],
                  "properties": {
                    "apiKeyId": { "type": "string" },
                    "from": { "type": "string", "format": "date" },
                    "to": { "type": "string", "format": "date" },
                    "totals": { "$ref": "#/components/schemas/UsageTotals" },
                    "daily": {
                      "type": "array",
                      "description": "One row per UTC day that has usage, oldest first. Days with no usage are omitted.",
                      "items": {
                        "allOf": [
                          { "$ref": "#/components/schemas/UsageTotals" },
                          {
                            "type": "object",
                            "required": ["day"],
                            "properties": {
                              "day": { "type": "string", "format": "date" }
                            }
                          }
                        ]
                      }
                    },
                    "byModel": {
                      "type": "array",
                      "description": "Totals for the window, split by model slug.",
                      "items": {
                        "allOf": [
                          { "$ref": "#/components/schemas/UsageTotals" },
                          {
                            "type": "object",
                            "required": ["modelSlug"],
                            "properties": {
                              "modelSlug": { "type": "string" }
                            }
                          }
                        ]
                      }
                    }
                  }
                },
                "example": {
                  "apiKeyId": "5f0c8a1e-2b4d-4c7e-9a10-6d3f2e1b0c9a",
                  "from": "2026-09-01",
                  "to": "2026-09-30",
                  "totals": {
                    "requestCount": 120,
                    "inputTokens": 900000,
                    "outputTokens": 45000,
                    "cachedInputTokens": 120000
                  },
                  "daily": [
                    {
                      "day": "2026-09-29",
                      "requestCount": 40,
                      "inputTokens": 300000,
                      "outputTokens": 15000,
                      "cachedInputTokens": 40000
                    }
                  ],
                  "byModel": [
                    {
                      "modelSlug": "subconscious/glm-5.3-marathon",
                      "requestCount": 120,
                      "inputTokens": 900000,
                      "outputTokens": 45000,
                      "cachedInputTokens": 120000
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "The window from `from` to `to` is longer than 90 days.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Usage window must not exceed 90 days" }
              }
            }
          },
          "401": {
            "description": "Missing or inactive management key.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "403": {
            "description": "The key is not a management key.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "404": {
            "description": "No active inference key in this organization matches the prefix.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "500": {
            "description": "Usage could not be read.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/api/v1/usage": {
      "get": {
        "operationId": "getUsage",
        "summary": "Get usage",
        "description": "Today's usage for the organization that owns the inference key: plan, credit balance, daily allowance, and tokens consumed today by model. Authenticate with an inference key (`Authorization: Bearer` or `X-API-Key`). Management keys are rejected. The allowance is a percentage of today's grant. The grant amount itself is not included.",
        "security": [
          { "bearerAuth": [] },
          { "apiKeyAuth": [] }
        ],
        "x-codeSamples": [
          {
            "lang": "bash",
            "label": "cURL",
            "source": "curl https://platform.subconscious.dev/api/v1/usage \\\n  -H \"Authorization: Bearer sk-gw-...\""
          }
        ],
        "responses": {
          "200": {
            "description": "Organization usage snapshot.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Usage" },
                "example": {
                  "billingMode": "subscription",
                  "plan": {
                    "label": "Heavy",
                    "status": "active",
                    "isUnlimitedComp": false,
                    "dailyAllowance": {
                      "basis": "credit",
                      "percent": 5.5,
                      "resetAt": "2026-09-24T00:00:00.000Z"
                    }
                  },
                  "credits": {
                    "balanceDollars": 12.34,
                    "overageThisPeriodDollars": 0
                  },
                  "models": [
                    {
                      "slug": "subconscious/glm-5.3-marathon",
                      "consumedToday": 44500000
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing, inactive, or non-inference API key.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "403": {
            "description": "The organization does not have closed-beta access.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Closed-beta access is required" }
              }
            }
          },
          "502": {
            "description": "Usage could not be read.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key in the Authorization header. Management endpoints require a management key (`sk-mgmt-...`). GET /api/v1/usage requires an inference key (`sk-gw-...`)."
      },
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Same key as bearer auth, passed in the X-API-Key header."
      }
    },
    "parameters": {
      "keyPrefix": {
        "name": "keyPrefix",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "example": "a1b2c3d4" },
        "description": "Prefix returned when the inference key was created."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" }
        }
      },
      "UsageTotals": {
        "type": "object",
        "required": ["requestCount", "inputTokens", "outputTokens", "cachedInputTokens"],
        "properties": {
          "requestCount": { "type": "integer", "description": "Number of requests." },
          "inputTokens": { "type": "integer", "description": "Input tokens metered for the key." },
          "outputTokens": { "type": "integer", "description": "Output tokens metered for the key." },
          "cachedInputTokens": { "type": "integer", "description": "Input tokens served from cache." }
        }
      },
      "Usage": {
        "type": "object",
        "required": ["billingMode", "plan", "credits", "models"],
        "properties": {
          "billingMode": {
            "type": ["string", "null"],
            "description": "How the organization is billed, such as `subscription` or `prepaid`. Null when the organization has no plan."
          },
          "plan": {
            "type": "object",
            "required": ["label", "status", "isUnlimitedComp", "dailyAllowance"],
            "properties": {
              "label": { "type": ["string", "null"], "description": "Plan name. Null when the organization has no plan." },
              "status": { "type": ["string", "null"], "description": "Plan status, such as `active`." },
              "isUnlimitedComp": { "type": "boolean" },
              "dailyAllowance": {
                "description": "Share of today's allowance. Null for unlimited plans and for organizations with no allowance. `percent` can exceed 100 when usage is past the allowance. `basis` is `credit` when the day is sized in credits, `tokens` when it is sized in tokens, and `unavailable` when a credit-billed read failed.",
                "oneOf": [
                  { "$ref": "#/components/schemas/CreditOrTokenAllowance" },
                  { "$ref": "#/components/schemas/UnavailableAllowance" },
                  { "type": "null" }
                ]
              }
            }
          },
          "credits": {
            "type": "object",
            "required": ["balanceDollars", "overageThisPeriodDollars"],
            "properties": {
              "balanceDollars": {
                "type": ["number", "null"],
                "description": "Spendable credit balance in dollars. Null when the balance cannot be read."
              },
              "overageThisPeriodDollars": {
                "type": "number",
                "description": "Overage for the current period, in dollars. Currently always 0."
              }
            }
          },
          "models": {
            "type": "array",
            "description": "Models with usage today. A model with no usage today is omitted, which means zero tokens so far.",
            "items": {
              "type": "object",
              "required": ["slug", "consumedToday"],
              "properties": {
                "slug": { "type": "string", "example": "subconscious/glm-5.3-marathon" },
                "consumedToday": {
                  "type": "integer",
                  "description": "Tokens consumed by this model since UTC midnight."
                }
              }
            }
          }
        }
      },
      "CreditOrTokenAllowance": {
        "type": "object",
        "required": ["basis", "percent", "resetAt"],
        "properties": {
          "basis": { "type": "string", "enum": ["credit", "tokens"] },
          "percent": { "type": "number", "description": "Percent of today's allowance already used. Can exceed 100." },
          "resetAt": { "type": "string", "format": "date-time", "description": "When the daily counter resets (UTC midnight)." }
        }
      },
      "UnavailableAllowance": {
        "type": "object",
        "required": ["basis", "resetAt"],
        "properties": {
          "basis": { "type": "string", "enum": ["unavailable"] },
          "resetAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
